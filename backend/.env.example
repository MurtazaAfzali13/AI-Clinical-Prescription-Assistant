ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# OpenRouter (OpenAI-compatible) — used for the chat LLM, embeddings, and voice-to-text (Whisper)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=openai/gpt-4o-mini
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=openai/text-embedding-3-small
STT_MODEL_NAME=openai/whisper-1

# Pinecone
PINECONE_API_KEY=
INDEX_NAME=drug-knowledge-base

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
